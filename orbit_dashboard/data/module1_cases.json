{
  "module": {
    "number": 1,
    "title": "Image Quality and Error Correction",
    "goal": "Develop the ability to identify radiographic errors, understand their causes, and apply corrective techniques to produce diagnostic-quality images.",
    "objectives": [
      {
        "n": 1,
        "text": "Accurately classify radiographs as diagnostic or non-diagnostic with ≥90% accuracy",
        "target": "≥90%"
      },
      {
        "n": 2,
        "text": "Identify common radiographic errors (e.g., cone cut, overlap, elongation, foreshortening, motion artifact, exposure errors) with ≥ 90% accuracy",
        "target": "≥90%"
      },
      {
        "n": 3,
        "text": "Determine the most likely cause of radiographic errors, including positioning, angulation, receptor placement, and exposure technique, in ≥90% of cases",
        "target": "≥90%"
      },
      {
        "n": 4,
        "text": "Select the appropriate corrective action needed to produce a diagnostic-quality image in ≥90% of cases",
        "target": "≥90%"
      },
      {
        "n": 5,
        "text": "Differentiate errors requiring retake from acceptable diagnostic variation in ≥90% of cases",
        "target": "≥90%"
      },
      {
        "n": 6,
        "text": "Explain how specific image quality errors impact diagnostic interpretation and clinical decision-making in ≥90% of responses",
        "target": "≥90%"
      }
    ]
  },
  "cases": [
