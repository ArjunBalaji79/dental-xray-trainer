      "id": "M1-02",
      "name": "Horizontal Overlap BW",
      "modality": "Bitewing",
      "difficulty": 2,
      "ground_truth": "Horizontal overlap",
      "notes": "Incorrect horizontal",
      "finding": "The proximal contacts of the posterior teeth are superimposed — the enamel surfaces overlap and the interproximal areas cannot be evaluated.",
      "pearl": "Open contacts require the beam to pass perpendicular to the buccal surfaces — correct horizontal angulation.",
      "steps": [
        {
          "n": 1,
          "key": "diagnostic",
          "objective": 1,
          "answer_type": "Binary",
          "prompt": "Is this radiograph diagnostic or non-diagnostic?",
          "options": [
            "Diagnostic",
            "Non-diagnostic"
          ],
          "expected": "Non-diagnostic",
          "feedback": "Overlapping contacts limit interpretation",
          "points": 1
        },
        {
          "n": 2,
          "key": "error",
          "objective": 2,
          "answer_type": "Single Select",
          "prompt": "What is the primary radiographic error?",
          "options": [
            "Cone cut",
            "Horizontal overlap",
            "Elongation",
            "Foreshortening",
            "Motion artifact",
            "Underexposure",
            "Overexposure",
            "Herringbone artifact"
          ],
          "expected": "Horizontal overlap",
          "feedback": "Contacts are superimposed",
          "points": 2
        },
        {
          "n": 3,
          "key": "cause",
          "objective": 3,
          "answer_type": "Single Select",
          "prompt": "What most likely caused this error?",
          "options": [
            "Sensor positioned incorrectly",
            "Incorrect horizontal angulation",
            "Incorrect vertical angulation",
            "Patient movement",
            "Incorrect exposure settings"
          ],
          "expected": "Incorrect horizontal angulation",
          "feedback": "Beam angulation was improper",
          "points": 2
        },
        {
          "n": 4,
          "key": "correction",
          "objective": 4,
          "answer_type": "Single Select",
          "prompt": "What adjustment would best correct this issue?",
          "options": [
            "Adjust horizontal angulation",
            "Reposition sensor",
            "Adjust vertical angulation",
            "Stabilize patient",
            "Modify exposure settings"
